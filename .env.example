# ─────────────────────────────────────────────────────────────────────────────
# InsightIQ — Environment Variable Template
#
# Copy this file to .env in the project root and fill in your own values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL database connection ─────────────────────────────────────────────────
# DB_NAME must point to a database that has had BOTH migration phases applied:
#   Phase 1  backend/migrations/PHASE1_AUTH_SCHEMA_DRAFT.sql   (auth tables)
#   Phase 2  backend/migrations/PHASE2_SALES_TENANT_MIGRATION.sql (business_id)
# Use a dedicated development database (e.g. insightiq_dev).
# Do NOT point this at ai_business_intelligence unless Phase 2 has been applied
# and verified there — analytics will fail with "Unknown column 'business_id'".
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=insightiq_dev

# ── Groq AI API ───────────────────────────────────────────────────────────────
# Obtain a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── AI model selection (optional) ─────────────────────────────────────────────
# Defaults to llama-3.1-8b-instant if not set.
AI_MODEL=llama-3.1-8b-instant

# ── AI request timeout in seconds (optional) ──────────────────────────────────
# Defaults to 15 seconds if not set.
AI_TIMEOUT_SECONDS=15

# ── Authentication foundation (Phase 1) ──────────────────────────────────────
# Generate a long random value; never commit the real value.
AUTH_JWT_SECRET=replace_with_a_long_random_secret
# Optional overrides; defaults are hardware-calibration starting points.
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST_KIB=65536
AUTH_ARGON2_PARALLELISM=2
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ACCESS_COOKIE_NAME=insightiq_access
AUTH_REFRESH_COOKIE_NAME=insightiq_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Optional production cookie domain; leave empty for host-only cookies.
AUTH_COOKIE_DOMAIN=
# Comma-separated exact browser origins required by CSRF validation.
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend API base URL (optional) ──────────────────────────────────────────
# Set inside frontend/.env if you change the backend port.
# VITE_API_BASE_URL=http://127.0.0.1:8000
